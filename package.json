{
  "name": "falaj",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Falaj: United Arab Emirates University's public website as ten typed, read-only MCP tools, read through TinyFish.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && wrangler deploy --dry-run",
    "migrate:local": "wrangler d1 migrations apply falaj --local",
    "migrate:remote": "wrangler d1 migrations apply falaj --remote",
    "health": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.16",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261103.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "wrangler": "4.156.2"
  }
}
